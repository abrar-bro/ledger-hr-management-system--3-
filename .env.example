# Copy this file to .env and fill in your real backend later.
# While these are empty, the app runs fully offline using
# /public/employees.json as mock data and the browser's
# localStorage as the attendance "database".

# Base URL of your HR REST API, no trailing slash.
# Using the included server/ backend? Run it (see server/README.md) and set:
# VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_BASE_URL=

# Optional bearer token / API key sent as "Authorization: Bearer <key>".
VITE_API_KEY=
