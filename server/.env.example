# Port the Ledger HR API server listens on.
PORT=4000

# MySQL connection. The database itself is created automatically on first
# run if it doesn't exist yet (the user below needs CREATE privileges for
# that) — or create it yourself beforehand and point DB_NAME at it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ledgerhr
